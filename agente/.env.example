# 🚀 VARIÁVEIS DE AMBIENTE PARA DEPLOY - EXEMPLO
# Copie estas variáveis para o seu provedor de deploy (Heroku, EasyPanel, etc)

# API OpenAI (obrigatório)
OPENAI_API_KEY=sua_chave_openai_aqui

# URL do Dashboard (produção)
DASHBOARD_URL=https://fastapi.urbanmt.com.br

# Database PostgreSQL (mesmo da API)
MEMORY_DB_URL=postgresql://n8n_user:n8n_pw@148.230.73.27:5432/n8n_db
DATABASE_URL=postgresql://n8n_user:n8n_pw@148.230.73.27:5432/n8n_db

# AGNO API Key (se necessário)
